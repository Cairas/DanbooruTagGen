# 빌드 산출물
bin/
obj/
.vs/
*.user

# ── 로컬 전용 (git에 올리지 않음) ─────────────────────────────
# 이 저장소에는 코드와 태그 사전(data/*.csv)만 올린다.
# 레시피·풀 같은 컨셉 데이터와 제작 문서는 전부 로컬에만 둔다.
# 앱은 아래 파일이 없어도 정상 기동한다(전부 빈 값으로 폴백).

# 컨셉 데이터
data/presets/
data/conflicts.csv
data/anima-phrases.csv

# 로컬 전용 디렉터리는 전부 앞에 '/'를 붙여 저장소 루트에만 걸리게 한다. 붙이지 않으면
# 어느 깊이의 같은 이름 폴더에나 걸리고, Windows(core.ignorecase)에서는 대소문자도 무시돼
# `tags/`가 소스 폴더 src/DanbooruTagGen.Core/Tags/까지 삼켜 TagDatabase 등이 한 번도
# 커밋되지 않았다(새로 클론하면 빌드 불가).

# 제작 문서·작업 기록
/guide.md
/WORKLOG.md
/docs/

# 개발용 스캐너와 그 실행 결과
/tools/

# 태그 원본 덤프 (앱은 data/*.csv만 읽는다)
/tags/

# 작업 중 생긴 임시 파일·개발 환경 부산물
_scr_*.txt
.superpowers/
*.lnk
