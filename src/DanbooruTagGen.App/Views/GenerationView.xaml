<UserControl x:Class="DanbooruTagGen.App.Views.GenerationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 생성 카드(두 탭 공통). 매번 만지는 것만 위에: 대상 · 줄 수 · 파일 · 쓰기 방식 · 프로필 · 버튼 · 결과 요약 · 미리보기.
         나머지 설정은 아래 '고급 설정'(접힘). 결과 목록·줄 출처·📌 잠금은 [결과 크게 보기] 창에. -->
    <DockPanel Margin="8,6,8,8">
        <TextBlock DockPanel.Dock="Top" Text="생성" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
        <Border DockPanel.Dock="Top" Background="#EEF4FF" BorderBrush="#B6CCF5" BorderThickness="1" CornerRadius="3" Padding="6,3" Margin="0,0,0,6">
            <TextBlock Text="{Binding TargetText}" TextWrapping="Wrap"/>
        </Border>
        <TextBlock DockPanel.Dock="Top" Text="{Binding HookSummaryText}" FontSize="11" Foreground="#6A1B9A" Margin="0,0,0,4" TextWrapping="Wrap"
                   Visibility="{Binding HookSummaryText, Converter={StaticResource NonEmptyToVis}}"/>

        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="줄 수" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                <TextBox Width="70" Text="{Binding LineCount}"/>
                <TextBlock Text="  기본값 — 레시피별은 왼쪽 목록에서" FontSize="11" Foreground="#777" VerticalAlignment="Center"
                           Visibility="{Binding IsMultiRecipeMode, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
            <TextBlock Grid.Row="1" Text="출력 파일" VerticalAlignment="Center"/>
            <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,2">
                <Button DockPanel.Dock="Right" Content="찾기…" Command="{Binding BrowseOutputCommand}" Margin="4,0,0,0" Padding="6,0"/>
                <TextBox Text="{Binding OutputPath}" ToolTip="{Binding OutputPath}"/>
            </DockPanel>
            <TextBlock Grid.Row="2" Text="쓰기 방식" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                <RadioButton GroupName="WriteMode" Content="덮어쓰기" IsChecked="{Binding IsOverwrite}" Margin="0,0,10,0"/>
                <RadioButton GroupName="WriteMode" Content="이어쓰기" IsChecked="{Binding IsAppend}" Margin="0,0,10,0"/>
                <RadioButton GroupName="WriteMode" Content="새 파일" IsChecked="{Binding IsNew}"
                             ToolTip="같은 이름의 파일이 이미 있으면 아무것도 쓰지 않고 알립니다."/>
            </StackPanel>
            <CheckBox Grid.Row="3" Grid.Column="1" Content="레시피마다 파일 따로 (폴더에 이름.txt)" Margin="0,2"
                      IsChecked="{Binding SplitFilesPerRecipe}"
                      Visibility="{Binding IsMultiRecipeMode, Converter={StaticResource BoolToVis}}"
                      ToolTip="위 '출력 파일'의 폴더에 '레시피 이름.txt'로 팩마다 하나씩 씁니다(이름이 겹치면 -2를 붙임)."/>
            <TextBlock Grid.Row="4" Text="출력 프로필" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,2" ItemsSource="{Binding OutputProfiles}" SelectedItem="{Binding SelectedOutputProfile}"
                      ToolTip="모델(IL/Anima)별 출력 설정 묶음 — 품질 태그·'_'→공백·빈 줄·자동 정렬과 토큰 기준이 한 번에 바뀝니다. 저장·삭제는 고급 설정에서."/>
            <!-- 토큰 기준: 지금 적용되는 값(미리보기·결과의 토큰 수, 로그의 '토큰 기준 초과'). 프로필을 고르면 그 값으로 바뀐다. -->
            <TextBlock Grid.Row="5" Text="토큰 기준" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                <ComboBox Width="80" ItemsSource="{Binding ModelKinds}" SelectedItem="{Binding ProfileModel}"
                          ToolTip="출력을 넣을 모델 — 토큰을 그 모델의 실제 토크나이저로 셉니다(IL = CLIP, Anima = Qwen3)."/>
                <TextBox Width="50" Margin="4,0,0,0" Text="{Binding ProfileTokenLimitText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                         ToolTip="이 토큰 수를 넘는 줄을 주황으로 표시하고 생성 때 로그에 남깁니다. 비우면 모델 기본값."/>
                <TextBlock Text="  비우면 IL 225 · Anima 512" FontSize="11" Foreground="#777" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,8,0,4">
            <Button Content="미리보기 (F5)" Command="{Binding PreviewCommand}" Padding="10,4"
                    ToolTip="레시피마다 몇 줄만 뽑아 아래에 띄웁니다(일괄은 레시피마다 3줄, 하나면 10줄). 📌 잠근 줄은 그대로 둡니다."/>
            <Button Content="생성 (Ctrl+Enter)" Command="{Binding GenerateCommand}" Margin="8,0,0,0" Padding="14,4" FontWeight="Bold"
                    Background="#1F6FEB" Foreground="White"
                    ToolTip="파일에 씁니다. 📌 잠근 줄은 결과에 그대로 들어가고 나머지 줄 수만큼만 새로 뽑습니다."/>
            <Button Content="■ 취소" Command="{Binding CancelCommand}" Margin="8,0,0,0" Padding="6,0"
                    Visibility="{Binding ProgressText, Converter={StaticResource NonEmptyToVis}}"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding ProgressText}" FontSize="11" Foreground="#555"
                   Visibility="{Binding ProgressText, Converter={StaticResource NonEmptyToVis}}"/>
        <TextBlock DockPanel.Dock="Top" Text="{Binding ResultSummaryText}" Foreground="#1B5E20" TextWrapping="Wrap" FontSize="12"
                   Visibility="{Binding ResultSummaryText, Converter={StaticResource NonEmptyToVis}}"/>
        <DockPanel DockPanel.Dock="Top" Visibility="{Binding ProblemSummaryText, Converter={StaticResource NonEmptyToVis}}">
            <Button DockPanel.Dock="Right" Content="로그 보기" Command="{Binding OpenLogCommand}" Padding="6,0" FontSize="11" Margin="4,0,0,0"/>
            <TextBlock Text="{Binding ProblemSummaryText}" Foreground="#B71C1C" TextWrapping="Wrap" FontSize="12"/>
        </DockPanel>

        <!-- 아래쪽 고정: 토큰 요약 · 결과 크게 보기 · 고급 설정 -->
        <Expander DockPanel.Dock="Bottom" Header="{Binding AdvancedSummaryText}" Margin="0,6,0,0">
            <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4,4,0,0">
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Left" Text="시드" Width="40" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding SeedText}" ToolTip="-1 또는 빈 칸 = 매번 랜덤(단, 미리보기 바로 뒤 [생성]은 그 미리보기 시드를 이어 써서 본 줄이 파일 앞쪽에 들어감). 숫자를 넣으면 그 시드로 고정(재현 가능)."/>
                    </DockPanel>
                    <CheckBox Content="줄 내 중복 제거" IsChecked="{Binding DedupeWithinLine}"/>
                    <CheckBox Content="줄 중복 회피" IsChecked="{Binding AvoidDuplicateLines}"/>
                    <CheckBox Margin="16,0,0,0" IsChecked="{Binding StopWhenExhausted}" IsEnabled="{Binding AvoidDuplicateLines}"
                              Content="조합이 바닥나면 멈춤 (중복 줄 안 넣음)"
                              ToolTip="서로 다른 줄을 더 만들 수 없으면 요청 줄 수를 못 채워도 멈춥니다(조합이 작은 레시피는 가능한 조합을 전부 씀). 끄면 중복 줄을 넣어 줄 수를 맞춥니다."/>
                    <CheckBox Content="모순 태그 회피 (예: long_hair + short_hair)" IsChecked="{Binding AvoidConflicts}"/>
                    <CheckBox Margin="16,0,0,0" IsChecked="{Binding LocalConflictFiltering}" IsEnabled="{Binding AvoidConflicts}"
                              Content="슬롯 단위로 먼저 걸러내기 (앞쪽 슬롯 우선)"/>
                    <CheckBox Content="_→공백 (long_hair → long hair)" IsChecked="{Binding UnderscoreToSpace}"/>
                    <CheckBox Content="빈도 가중 추첨 (인기 태그 우대)" IsChecked="{Binding WeightedSampling}"/>
                    <CheckBox Content="태그 순서 자동 배치 (표준 프롬프트 순서)" IsChecked="{Binding AutoOrderTags}"/>
                    <CheckBox Content="파일에 빈 줄 띄움" IsChecked="{Binding InsertBlankLine}"/>
                    <CheckBox Content="품질 태그를 매 줄 앞에 붙이기" IsChecked="{Binding QualityTagsEnabled}" Margin="0,4,0,0"/>
                    <TextBox Margin="16,2,0,0" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="60" VerticalScrollBarVisibility="Auto"
                             Text="{Binding QualityTagsText, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding QualityTagsEnabled, Converter={StaticResource BoolToVis}}"/>
                    <CheckBox Content="생성할 때마다 결과 창 자동으로 열기" IsChecked="{Binding AutoOpenResults}" Margin="0,4,0,0"/>

                    <TextBlock Text="출력 프로필 저장" FontWeight="Bold" Margin="0,8,0,2"/>
                    <WrapPanel>
                        <TextBox Width="90" Text="{Binding OutputProfileName, UpdateSourceTrigger=PropertyChanged}" ToolTip="프로필 이름(예: Anima, IL)" Margin="0,0,4,2"/>
                        <Button Content="저장" Command="{Binding SaveOutputProfileCommand}" Padding="6,0" Margin="0,0,4,2"
                                ToolTip="지금 출력 설정(품질 태그·'_'→공백·빈 줄·자동 정렬)과 위 '토큰 기준'의 모델·숫자를 이 이름으로 저장하고 그 프로필을 고릅니다(같은 이름이면 덮어씀)."/>
                        <Button Content="삭제" Command="{Binding DeleteOutputProfileCommand}" Padding="6,0" Margin="0,0,0,2"/>
                    </WrapPanel>
                    <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="#555" TextWrapping="Wrap"
                               Text="생성 훅(생성할 때만 끼워 넣는 슬롯)은 툴바의 '생성 훅'에서 설정합니다."/>
                </StackPanel>
            </ScrollViewer>
        </Expander>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
            <Button DockPanel.Dock="Right" Content="결과 크게 보기" Command="{Binding OpenResultsCommand}" Padding="8,1"
                    ToolTip="결과 목록 · 줄 출처 · 📌 잠금 · 결과 검색 · 줄별 토큰(창은 버튼을 눌렀을 때만 뜹니다)."/>
            <TextBlock Text="{Binding TokenSummaryText}" FontSize="11" Foreground="#555" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding LockedCountText}" FontSize="11" Foreground="#6A1B9A"
                   Visibility="{Binding LockedCountText, Converter={StaticResource NonEmptyToVis}}"/>

        <!-- 미리보기(남는 자리를 다 쓴다): 레시피 이름 머리줄 + 한 줄로 자른 출력 줄(툴팁에 전체) + 토큰 수 -->
        <Border BorderBrush="#D0D5DB" BorderThickness="1" Margin="0,6,0,0" Background="#FAFBFC">
            <Grid>
                <TextBlock Text="미리보기·생성 결과가 여기에 몇 줄 나옵니다." Foreground="#999" Margin="6" FontSize="11"
                           Visibility="{Binding PreviewLines.Count, Converter={StaticResource ZeroToVis}}"/>
                <ItemsControl ItemsSource="{Binding PreviewLines}" FontFamily="Consolas, Malgun Gothic" FontSize="11" Margin="4,2">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding Header}" FontFamily="Malgun Gothic" FontWeight="Bold" Foreground="#37474F" Margin="0,4,0,1"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding IsHeader, Converter={StaticResource BoolToVis}}"/>
                                <DockPanel Visibility="{Binding IsHeader, Converter={StaticResource InverseBoolToVis}}" ToolTip="{Binding FullText}">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Tokens}" Margin="6,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#9E9E9E"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Over}" Value="True">
                                                        <Setter Property="Foreground" Value="#E65100"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
