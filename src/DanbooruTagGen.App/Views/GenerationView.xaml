<UserControl x:Class="DanbooruTagGen.App.Views.GenerationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Text="생성" FontWeight="Bold"/>
        <Grid DockPanel.Dock="Top" Margin="0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="줄 수" VerticalAlignment="Center"/>
            <TextBox  Grid.Row="0" Grid.Column="1" Text="{Binding LineCount}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="시드" VerticalAlignment="Center"/>
            <TextBox  Grid.Row="1" Grid.Column="1" Text="{Binding SeedText}" ToolTip="-1 또는 빈 칸 = 매번 랜덤. 숫자를 넣으면 그 시드로 고정(재현 가능)."/>
            <CheckBox Grid.Row="2" Grid.Column="1" Content="줄 내 중복 제거" IsChecked="{Binding DedupeWithinLine}"/>
            <CheckBox Grid.Row="3" Grid.Column="1" Content="줄 중복 회피" IsChecked="{Binding AvoidDuplicateLines}"/>
            <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding AvoidConflicts}"
                      Content="모순 태그 회피 (예: long_hair + short_hair)"
                      ToolTip="data/conflicts.csv의 상호배타 그룹이 한 줄에 같이 들어가면 재추첨"/>
            <CheckBox Grid.Row="5" Grid.Column="1" Content="_→공백 (long_hair → long hair)" IsChecked="{Binding UnderscoreToSpace}"/>
            <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding WeightedSampling}"
                      Content="빈도 가중 추첨 (인기 태그 우대)"
                      ToolTip="danbooru 빈도의 제곱근에 비례해 추첨. 끄면 후보를 동등 확률로 뽑는다."/>
            <CheckBox Grid.Row="7" Grid.Column="1" IsChecked="{Binding AutoOrderTags}"
                      Content="태그 순서 자동 배치 (표준 프롬프트 순서)"
                      ToolTip="한 줄을 품질→인원→외형→의상→행위→소품→배경→형식 순으로 정렬. 미분류 태그는 원래 위치 유지."/>
            <CheckBox Grid.Row="8" Grid.Column="1" IsChecked="{Binding AnimaFormat}"
                      Content="Anima 출력 (태그 + 영어 서술문)"
                      ToolTip="Anima는 Qwen LLM을 텍스트 인코더로 써서 자연어를 잘 읽는 대신 태그 과밀에 민감하다.&#10;구도·조명 같은 장식 축을 빼고, 남은 태그를 data/anima-phrases.csv로 영어 서술문으로 바꿔 덧붙인다.&#10;끄면 기존 태그 나열 그대로(Illustrious 계열용)."/>
            <TextBlock Grid.Row="9" Grid.Column="0" Text="출력" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" Width="110"/>
                <CheckBox Content="빈 줄 띄움" IsChecked="{Binding InsertBlankLine}" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Grid.Row="10" Grid.Column="0" Text="파일" VerticalAlignment="Center"/>
            <DockPanel Grid.Row="10" Grid.Column="1">
                <Button DockPanel.Dock="Right" Content="찾아보기..." Command="{Binding BrowseOutputCommand}" Margin="4,0,0,0"/>
                <TextBox Text="{Binding OutputPath}"/>
            </DockPanel>
        </Grid>
        <!-- 여러 레시피 일괄 생성: 켜면 아래 체크 목록에서 고른 레시피들을 레시피별로
             묶어서(순서대로) 이어붙인다. 줄 수는 위 "줄 수" 설정이 레시피마다 동일 적용. -->
        <CheckBox DockPanel.Dock="Top" Content="여러 레시피 일괄 생성" Margin="0,0,0,4"
                  IsChecked="{Binding IsMultiRecipeMode}"/>
        <!-- 아래 영역(체크 목록/미리보기)이 창 크기에 맞춰 늘어나도록 Grid의 별표(Star) 행으로
             분배 — 체크 목록:미리보기 = 2:1 비중이라 목록이 더 크게 늘어난다. 일괄 생성 모드가
             꺼져 있으면 목록 행 높이가 0으로 접혀 미리보기가 전체 공간을 쓴다. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition>
                    <RowDefinition.Style>
                        <Style TargetType="RowDefinition">
                            <Setter Property="Height" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMultiRecipeMode}" Value="True">
                                    <Setter Property="Height" Value="2*"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </RowDefinition.Style>
                </RowDefinition>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,4"
                       Visibility="{Binding IsMultiRecipeMode, Converter={StaticResource BoolToVis}}">
                <TextBlock DockPanel.Dock="Top" Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                           Text="일괄 생성할 레시피를 체크하세요 — 위 '줄 수' 설정이 레시피마다 동일하게 적용되고, 결과는 레시피별로 묶여 순서대로 이어붙습니다."/>
                <TextBox DockPanel.Dock="Top" Margin="0,2,0,2"
                         Text="{Binding BatchSearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="레시피 이름으로 검색 (부분 일치)"/>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,2">
                    <Button Content="전체 선택" Command="{Binding SelectAllBatchItemsCommand}"/>
                    <Button Content="🔞 전체" Command="{Binding SelectNsfwBatchItemsCommand}" Margin="4,0,0,0"
                            ToolTip="이름이 🔞로 시작하는 레시피만 선택합니다(기존 선택은 해제)."/>
                    <Button Content="SFW 전체" Command="{Binding SelectSfwBatchItemsCommand}" Margin="4,0,0,0"
                            ToolTip="🔞가 아닌 레시피만 선택합니다(기존 선택은 해제)."/>
                    <Button Content="전체 선택 해제" Command="{Binding DeselectAllBatchItemsCommand}" Margin="4,0,0,0"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding BatchItems}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4">
                <Button Content="미리보기" Command="{Binding PreviewCommand}"/>
                <Button Content="생성" Command="{Binding GenerateCommand}" Margin="8,0,0,0" FontWeight="Bold"/>
            </StackPanel>

            <!-- 결과 모순 리포트: 모순 줄이 있으면 빨간 박스로 표시 -->
            <Border Grid.Row="2" Background="#FFF3F3" BorderBrush="#E57373" BorderThickness="1"
                    Margin="0,4,0,0" Padding="6" MaxHeight="140"
                    Visibility="{Binding ConflictReport, Converter={StaticResource NonEmptyToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding ConflictReport}" Foreground="#B71C1C" TextWrapping="Wrap" FontSize="11"/>
                </ScrollViewer>
            </Border>

            <TextBox Grid.Row="3" Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True"
                     Margin="0,4,0,0"
                     VerticalScrollBarVisibility="Auto" AcceptsReturn="True" FontFamily="Consolas"/>
        </Grid>
    </DockPanel>
</UserControl>
