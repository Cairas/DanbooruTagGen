<!-- 크기는 코드비하인드가 Settings에서 복원/저장한다(Height/Width 기본값은 첫 실행용). -->
<Window x:Class="DanbooruTagGen.App.Views.RecipeLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="레시피 라이브러리" Height="560" Width="760" MinHeight="360" MinWidth="520">
    <Grid Margin="8">
        <!-- 왼쪽 목록 패널 너비는 GridSplitter로 런타임 조절 가능. 코드비하인드가
             Settings.RecipeLibraryLeftPanelWidth에서 복원/저장한다(사용자별 설정, git 제외). -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftPanelColumn" Width="220" MinWidth="120"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0" Margin="0,0,4,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                <Button Content="+현재 상태" Command="{Binding SaveCurrentAsNewCommand}"
                        ToolTip="지금 레시피 빌더의 슬롯 구성을 새 이름으로 저장합니다."/>
                <Button Content="복제" Command="{Binding DuplicateSelectedCommand}" Margin="4,0"
                        ToolTip="선택한 레시피를 통째로 복제해 바로 옆에 '(사본)'으로 추가합니다."/>
                <Button Content="삭제" Command="{Binding RemoveSelectedCommand}" Margin="0,0,4,0"/>
                <Button Content="저장" Command="{Binding SaveCommand}"/>
            </StackPanel>
            <!-- 일반/성인 필터: 레시피 내용물(슬롯 태그·참조 풀)로 판정. 태그 검색과 같은 3버튼. -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="전체" Padding="8,1"
                        Command="{Binding SelectFilterCommand}" CommandParameter="all"
                        Background="{Binding RecipeFilter, Converter={StaticResource NsfwFilterToBrush}, ConverterParameter=all}"/>
                <Button Content="일반" Padding="8,1" Margin="3,0"
                        Command="{Binding SelectFilterCommand}" CommandParameter="sfw"
                        Background="{Binding RecipeFilter, Converter={StaticResource NsfwFilterToBrush}, ConverterParameter=sfw}"/>
                <Button Content="🔞 성인" Padding="8,1"
                        Command="{Binding SelectFilterCommand}" CommandParameter="nsfw"
                        Background="{Binding RecipeFilter, Converter={StaticResource NsfwFilterToBrush}, ConverterParameter=nsfw}"/>
            </StackPanel>
            <!-- 즐겨찾기만 보기: 위 성인 필터·카테고리·검색과 전부 AND 결합. -->
            <CheckBox DockPanel.Dock="Top" Content="⭐ 즐겨찾기만" Margin="0,4,0,0"
                      IsChecked="{Binding ShowFavoritesOnly}"/>
            <!-- NSFW 카테고리 필터(촉수·몬스터·구속 등). "(전체)"는 필터 없음. -->
            <ComboBox DockPanel.Dock="Top" Margin="0,4,0,0"
                      ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"/>
            <!-- 이름 검색: 위 필터들과 AND 결합. 팩이 100개+라 스크롤만으론 못 찾는다. -->
            <TextBox DockPanel.Dock="Top" Margin="0,4,0,0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="레시피 이름으로 검색 (부분 일치)"/>
            <!-- 여러 레시피를 한 번에 생성 패널로 보낸다(Ctrl/Shift로 고른 것 전부, 또는
                 하나도 안 골랐으면 아래 SelectedRecipe 하나). 라이브러리에서 필터로 찾은 걸
                 그대로 보낼 수 있어, 생성 패널의 별도 체크리스트를 다시 검색할 필요가 없다. -->
            <Button DockPanel.Dock="Bottom" Content="✓ 선택 항목 일괄 생성으로 보내기" Margin="0,4,0,0"
                    Command="{Binding SendSelectedToBatchCommand}"
                    ToolTip="Ctrl/Shift로 여러 레시피를 선택한 뒤 누르면, 생성 패널의 '여러 레시피 일괄 생성' 체크 목록이 이걸로 교체됩니다."/>
            <!-- 모순 배지: ‼=고정 태그끼리 항상 충돌, ⚠=풀 후보까지 포함하면 충돌 가능.
                 RecipeLibraryViewModel이 목록을 채울 때 미리 계산해 Recipe.ConflictBadge에 넣어둔다.
                 SelectionMode=Extended: Ctrl/Shift로 여러 개 선택 가능 — SelectedItem(단일)은
                 그대로 마지막 포커스 항목을 가리켜 오른쪽 미리보기·불러오기는 기존 그대로 동작한다. -->
            <ListBox x:Name="RecipeListBox" ItemsSource="{Binding FilteredRecipes}" SelectedItem="{Binding SelectedRecipe}"
                     SelectionMode="Extended" SelectionChanged="RecipeListBox_SelectionChanged"
                     Margin="0,4,0,0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ConflictBadge}" Foreground="#B71C1C" FontWeight="Bold"
                                       Width="16" ToolTip="⚠ 풀 후보까지 포함하면 모순 가능 / ‼ 고정 태그끼리 항상 모순"/>
                            <TextBlock Text="{Binding Name}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                       Background="Transparent" ResizeBehavior="PreviousAndNext"/>
        <DockPanel Grid.Column="2">
            <DockPanel DockPanel.Dock="Top">
                <Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="8,1"
                        Command="{Binding ToggleFavoriteCommand}"
                        Content="{Binding SelectedRecipeIsFavorite, Converter={StaticResource FavoriteStarText}}"
                        ToolTip="선택한 레시피를 즐겨찾기에 추가/제거"/>
                <TextBox Text="{Binding SelectedRecipe.Name, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
            <!-- 불러오기는 레시피 빌더의 현재 슬롯 구성을 통째로 교체한다(되돌릴 수 없음 —
                 다만 빌더 자체가 창을 닫을 때 항상 last-recipe.json에 자동 저장되므로
                 직전 작업까지 완전히 사라지진 않는다). -->
            <Button DockPanel.Dock="Bottom" Content="이 레시피 불러오기 (현재 구성 교체)" Margin="0,4,0,0"
                    Command="{Binding LoadSelectedCommand}"
                    ToolTip="레시피 빌더의 현재 슬롯 구성을 이걸로 통째로 바꿉니다."/>
            <!-- 빠른 미리보기: 빌더 상태를 안 건드리고 이 레시피만으로 5줄 샘플을 즉석에서 뽑는다. -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                <Button DockPanel.Dock="Top" Content="샘플 5줄 미리보기" HorizontalAlignment="Left"
                        Command="{Binding QuickPreviewCommand}"
                        ToolTip="빌더를 안 건드리고 이 레시피로만 5줄을 즉석에서 뽑아봅니다."/>
                <TextBox DockPanel.Dock="Top" Margin="0,4,0,0" Text="{Binding QuickPreviewText, Mode=OneWay}"
                         IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         MaxHeight="110" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                         Visibility="{Binding QuickPreviewText, Converter={StaticResource NonEmptyToVis}}"/>
            </DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="미리보기·편집 (항목을 펼치면 태그를 지우거나 추가할 수 있습니다 — 창을 닫으면 자동 저장)"
                       Foreground="Gray" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <!-- 슬롯별 실제 내용물(편집 가능): 칩 클릭=삭제, 아래 입력칸=추가.
                 풀 참조 후보는 공용 풀이라 여기선 읽기 전용(풀 라이브러리에서 수정). -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4">
                <ItemsControl ItemsSource="{Binding SelectedRecipePreview}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander Header="{Binding Header}" IsExpanded="False" Margin="0,0,0,2">
                                <StackPanel Margin="18,2,4,4">
                                    <ItemsControl ItemsSource="{Binding InlineTags}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="0,0,4,2" Padding="4,0" ToolTip="클릭하여 제거"
                                                        Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Converter={StaticResource UnderToSpace}}"/>
                                                        <TextBlock Text="  ✕" Foreground="Gray"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <DockPanel Margin="0,2,0,0">
                                        <Button DockPanel.Dock="Right" Content="추가" Margin="4,0,0,0" FontSize="11"
                                                Command="{Binding AddTagCommand}"/>
                                        <TextBox Text="{Binding AddTagText, UpdateSourceTrigger=PropertyChanged}" FontSize="11"
                                                 ToolTip="이 슬롯에 태그 추가(콤마로 여러 개, 자연어 문구 허용)">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding AddTagCommand}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </DockPanel>
                                    <TextBlock Text="{Binding PoolTagsText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Foreground="#78909C" FontSize="11"
                                               Visibility="{Binding HasPool, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
