<Window x:Class="DanbooruTagGen.App.Views.ResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="결과 — 줄 확인 · 📌 잠금 · 줄 출처" Height="700" Width="1050" WindowStartupLocation="CenterOwner">
    <!-- 결과 크게 보기: 마지막 미리보기·생성의 모든 줄. 📌 잠근 줄은 다음 미리보기·생성에서 그대로 남는다.
         DataContext = GenerationViewModel(생성 카드와 같은 상태를 본다 — 다시 돌리면 내용이 바뀐다). -->
    <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="전체 복사 (Ctrl+Shift+C)" Command="{Binding CopyPreviewCommand}" Margin="4,0,0,0" Padding="6,0"/>
            <Button DockPanel.Dock="Right" Content="잠금 해제" Command="{Binding UnlockAllCommand}" Margin="4,0,0,0" Padding="6,0"
                    Visibility="{Binding LockedCountText, Converter={StaticResource NonEmptyToVis}}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding LockedCountText}" Foreground="#6A1B9A" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding ResultCountText}" Foreground="#555" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <TextBlock DockPanel.Dock="Left" Text="🔍" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox Text="{Binding ResultFilterText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                     ToolTip="결과에서 찾기: 공백으로 나눈 낱말이 전부 들어간 줄만(밑줄·공백 구분 없음, 대소문자 무시). '-낱말'은 그 낱말이 없는 줄. 잠금·복사·다시 뽑기는 가려진 줄까지 전부 기준입니다."/>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding ResultSummaryText}" Foreground="#1B5E20" Margin="0,0,0,4"
                   Visibility="{Binding ResultSummaryText, Converter={StaticResource NonEmptyToVis}}"/>

        <!-- 줄 출처: 고른 줄의 슬롯별 출처(무엇이 나왔고 무엇이 걸러졌는지). -->
        <Border DockPanel.Dock="Bottom" Margin="0,6,0,0" Padding="6,4" MaxHeight="220"
                Background="#F5F7FA" BorderBrush="#B0BEC5" BorderThickness="1"
                Visibility="{Binding SelectedOriginText, Converter={StaticResource NonEmptyToVis}}">
            <TextBox Text="{Binding SelectedOriginText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                     BorderThickness="0" Background="Transparent" FontSize="11.5" FontFamily="Consolas, Malgun Gothic"
                     VerticalScrollBarVisibility="Auto"/>
        </Border>

        <ListBox ItemsSource="{Binding ResultLines}" SelectedItem="{Binding SelectedResultLine}"
                 HorizontalContentAlignment="Stretch" FontFamily="Consolas, Malgun Gothic"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.InputBindings>
                <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopySelectedLineCommand}"/>
            </ListBox.InputBindings>
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="이 줄 복사 (Ctrl+C)" Command="{Binding CopySelectedLineCommand}"/>
                    <MenuItem Header="전체 복사 (Ctrl+Shift+C)" Command="{Binding CopyPreviewCommand}"/>
                    <Separator/>
                    <MenuItem Header="잠금 모두 해제" Command="{Binding UnlockAllCommand}"/>
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding HeaderText}" FontWeight="Bold" Foreground="#37474F" Margin="0,4,0,2" FontFamily="Malgun Gothic"
                                   Visibility="{Binding HeaderText, Converter={StaticResource NonEmptyToVis}}"/>
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Left" IsChecked="{Binding IsLocked}" Content="📌"
                                          Width="24" Height="20" Padding="0" Margin="0,0,4,0" VerticalAlignment="Top"
                                          ToolTip="잠그면 다음 미리보기·생성에서 이 줄을 그대로 남깁니다.">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Opacity" Value="0.3"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Opacity" Value="1"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Number}" Foreground="#9E9E9E" MinWidth="40" Margin="0,0,4,0" VerticalAlignment="Top"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Tokens}" FontSize="10" Margin="6,1,2,0" VerticalAlignment="Top"
                                       ToolTip="토큰 수(품질 태그 포함)">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#9E9E9E"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOverLimit}" Value="True">
                                                <Setter Property="Foreground" Value="#E65100"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasConflict}" Value="True">
                                                <Setter Property="Foreground" Value="#B71C1C"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
