<UserControl x:Class="DanbooruTagGen.App.Views.BatchRecipeListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- [일괄 생성] 탭: 레시피 고르기. DataContext = GenerationViewModel. 보기·검색은 "무엇을 보여 줄지"만 정하고,
         생성은 체크된 전부를 돌린다(가려진 체크는 아래 줄에 따로 센다). -->
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Text="레시피 고르기" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>

        <!-- 검색: 이름뿐 아니라 레시피에 든 태그·축 이름까지(예: netorare, 촉수). Ctrl+F로 여기로. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <TextBlock DockPanel.Dock="Left" Text="🔍" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="BatchSearchBox" Text="{Binding BatchSearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="레시피 이름·태그·축 이름으로 검색(부분 일치) — 예: netorare, 촉수, 임신"/>
        </DockPanel>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <RadioButton GroupName="BatchFilter" Style="{StaticResource {x:Type ToggleButton}}" Content="전체" Padding="10,2" Margin="0,0,4,0"
                         IsChecked="{Binding FilterAll}"/>
            <RadioButton GroupName="BatchFilter" Style="{StaticResource {x:Type ToggleButton}}" Content="일반" Padding="10,2" Margin="0,0,4,0"
                         IsChecked="{Binding FilterSfw}"/>
            <RadioButton GroupName="BatchFilter" Style="{StaticResource {x:Type ToggleButton}}" Content="🔞 성인" Padding="10,2" Margin="0,0,4,0"
                         IsChecked="{Binding FilterNsfw}"/>
            <RadioButton GroupName="BatchFilter" Style="{StaticResource {x:Type ToggleButton}}" Content="{Binding ChangedFilterText}" Padding="10,2"
                         IsChecked="{Binding FilterChanged}"
                         ToolTip="프리셋 갱신으로 새로 들어왔거나(🆕) 바뀐(✏️) 뒤 라이브러리에서 아직 안 열어 본 레시피만 보여 줍니다."/>
        </WrapPanel>

        <!-- 선택 조합 프리셋: 자주 쓰는 레시피 묶음을 이름 붙여 저장해 두고 한 번에 복원한다. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <TextBlock DockPanel.Dock="Left" Text="선택 프리셋" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <Menu DockPanel.Dock="Right" Background="Transparent" VerticalAlignment="Center" Margin="4,0,0,0">
                <MenuItem Header="저장 ▾" Padding="6,2" BorderBrush="#B9C1C9" BorderThickness="1">
                    <MenuItem Header="지금 체크로 새로 저장…" Command="{Binding SaveBatchPresetAsCommand}"/>
                    <MenuItem Header="고른 프리셋을 지금 체크로 업데이트" Command="{Binding UpdateBatchPresetCommand}"/>
                    <Separator/>
                    <MenuItem Header="고른 프리셋 삭제" Command="{Binding DeleteBatchPresetCommand}"/>
                </MenuItem>
            </Menu>
            <Button DockPanel.Dock="Right" Content="불러오기" Margin="4,0,0,0" Padding="8,1"
                    Command="{Binding LoadBatchPresetCommand}"
                    ToolTip="고른 프리셋의 레시피들을 체크합니다(기존 체크는 교체됩니다)."/>
            <ComboBox ItemsSource="{Binding BatchPresets}" SelectedItem="{Binding SelectedBatchPreset}" DisplayMemberPath="Name"
                      ToolTip="저장해 둔 선택 조합"/>
        </DockPanel>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <Button Content="보이는 것 전체 선택" Command="{Binding SelectAllBatchItemsCommand}" Padding="8,1" Margin="0,0,4,0"
                    ToolTip="지금 보이는(검색·보기에 맞는) 레시피를 전부 체크합니다. 일반/성인 보기에선 '프리뷰' 라벨 팩은 빼고 체크합니다."/>
            <Button Content="선택 해제" Command="{Binding DeselectAllBatchItemsCommand}" Padding="8,1" Margin="0,0,4,0"
                    ToolTip="지금 보이는 레시피의 체크를 풉니다."/>
            <Button Content="{Binding ProblemCountText}" Command="{Binding SelectProblemRecipesCommand}" Padding="8,1"
                    Foreground="#B71C1C" Visibility="{Binding ProblemCountText, Converter={StaticResource NonEmptyToVis}}"
                    ToolTip="마지막 일괄 생성에서 문제(조합 바닥·중복 줄·모순 남음)가 있던 레시피만 체크합니다 — 고친 뒤 그것만 다시 돌릴 때. 자세한 내용은 로그에."/>
        </WrapPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding CheckedCountText}" Margin="0,4,0,0" Foreground="#37474F"/>

        <!-- 목록 머리 + 목록: 체크 · 배지(🆕/✏️) · 이름(길면 …, 툴팁에 전체) · 줄 수(빈 칸 = 오른쪽 '줄 수' 기본값, 회색으로 보임). 가로 스크롤 없음. -->
        <Grid DockPanel.Dock="Top" Margin="6,0,24,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="2" Text="레시피" Foreground="#666" FontSize="11"/>
            <TextBlock Grid.Column="3" Text="줄 수" Foreground="#666" FontSize="11" HorizontalAlignment="Right"
                       ToolTip="이 레시피만 줄 수를 따로 정합니다. 비우면 오른쪽 '줄 수'(회색으로 보이는 값)를 씁니다. 레시피별로 기억됩니다."/>
        </Grid>
        <ListBox ItemsSource="{Binding BatchItems}" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Recipe.ChangeBadge}" VerticalAlignment="Center"
                                   ToolTip="🆕 프리셋 갱신으로 새로 들어옴 / ✏️ 내용이 바뀜 — 라이브러리에서 아직 안 열어 봄"/>
                        <TextBlock Grid.Column="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   ToolTip="{Binding Name}"/>
                        <Grid Grid.Column="3" Margin="4,0,0,0">
                            <TextBox Text="{Binding LineCountText, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold"
                                     HorizontalContentAlignment="Right" FontSize="11"/>
                            <TextBlock Text="{Binding DataContext.LineCount, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       Foreground="#AAA" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding IsLineCountEmpty, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
