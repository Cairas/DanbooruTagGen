<UserControl x:Class="DanbooruTagGen.App.Views.BatchRecipeListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- "여러 레시피 일괄 생성" 모드일 때 중앙 컬럼을 차지하는 체크리스트. DataContext는
         GenerationViewModel(MainWindow.xaml에서 {Binding Generation}으로 넘겨받음) — 새 VM
         없이 기존 배치 상태(BatchItems/BatchSearchText 등)를 그대로 쓴다. -->
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Text="여러 레시피 일괄 생성 — 체크리스트" FontWeight="Bold"/>
        <TextBlock DockPanel.Dock="Top" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,4"
                   Text="일괄 생성할 레시피를 체크하세요 — 우측 패널의 '줄 수' 설정이 레시피마다 동일하게 적용되고, 결과는 레시피별로 묶여 순서대로 이어붙습니다."/>

        <!-- 검색은 이름뿐 아니라 레시피에 실제로 들어있는 태그·축 이름까지 훑는다
             (GenerationViewModel.SelectableRecipeItem.SearchBlob) — 예: "netorare"를 치면
             그 태그가 FixedSlot이나 풀에 들어있는 레시피가 바로 걸린다. 별도 라벨 체크박스
             UI 없이 이 한 칸으로 끝나게 한 것 — 라벨을 일일이 붙이고 골라야 하는 수고를 없앴다. -->
        <TextBox DockPanel.Dock="Top" Margin="0,0,0,4"
                 Text="{Binding BatchSearchText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="레시피 이름, 태그, 축 이름으로 검색 (부분 일치) — 예: netorare, 촉수, 임신"/>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
            <Button Content="전체 선택" Command="{Binding SelectAllBatchItemsCommand}"/>
            <Button Content="🔞 전체" Command="{Binding SelectNsfwBatchItemsCommand}" Margin="4,0,0,0"
                    ToolTip="이름이 🔞로 시작하는 레시피만 선택합니다(기존 선택은 해제). 검색·라벨 필터가 걸려 있으면 그 안에서만 동작합니다."/>
            <Button Content="SFW 전체" Command="{Binding SelectSfwBatchItemsCommand}" Margin="4,0,0,0"
                    ToolTip="🔞가 아닌 레시피만 선택합니다(기존 선택은 해제)."/>
            <Button Content="전체 선택 해제" Command="{Binding DeselectAllBatchItemsCommand}" Margin="4,0,0,0"/>
        </StackPanel>

        <ListBox ItemsSource="{Binding BatchItems}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,1"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
