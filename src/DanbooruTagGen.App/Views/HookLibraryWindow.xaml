<Window x:Class="DanbooruTagGen.App.Views.HookLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="생성 훅" Height="560" Width="640" MinHeight="340" MinWidth="480">
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="Gray" FontSize="11"
                   Text="훅은 생성할 때만 레시피에 끼워 넣는 슬롯입니다 — 레시피 자체는 바뀌지 않습니다. 체크한 훅만 적용되며, 일괄 생성과 단일 생성 모두(미리보기 포함)에 들어갑니다."/>

        <!-- 자동 정렬이 켜져 있으면 출력이 표준 순서로 재배치돼 "몇 번째"가 의미를 잃는다.
             훅을 만들어 놓고 왜 위치가 안 맞는지 헤매는 걸 막으려고 창에서 바로 알린다. -->
        <Border DockPanel.Dock="Top" Margin="0,6,0,0" Padding="6" Background="#FFFBF0"
                BorderBrush="#E0A030" BorderThickness="1"
                Visibility="{Binding AutoOrderWarningVisible, Converter={StaticResource BoolToVis}}">
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#7A4B00"
                       Text="⚠ 생성 옵션의 '자동 정렬'이 켜져 있습니다. 출력이 표준 프롬프트 순서로 다시 정렬되므로 아래의 삽입 위치는 최종 결과에 반영되지 않습니다."/>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
            <Button Content="+ 훅 추가" Command="{Binding AddHookCommand}" Padding="8,2"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Margin="0,10,0,0" FontSize="11" Foreground="#78909C"
                   TextWrapping="Wrap"
                   Text="아직 훅이 없습니다. 아래 '+ 훅 추가'로 만들어 보세요 — 예: 맨 앞에 광원 축 랜덤 1개, 맨 뒤에 화풍 고정 태그."
                   Visibility="{Binding HasNoHooks, Converter={StaticResource BoolToVis}}"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
            <ItemsControl ItemsSource="{Binding Hooks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDDDDD" BorderThickness="1" Margin="0,0,0,6" Padding="6">
                            <StackPanel>
                                <DockPanel>
                                    <!-- 처음엔 작은 ✕였는데 이름칸에 바짝 붙어 있어 삭제 수단이 있는 줄도
                                         몰랐다는 피드백을 받았다 — 글자 라벨 + 여백으로 분리했다. -->
                                    <Button DockPanel.Dock="Right" Content="삭제" FontSize="11" Padding="8,1"
                                            Margin="8,0,0,0" Foreground="#B71C1C" ToolTip="이 훅을 삭제합니다"
                                            Command="{Binding DataContext.RemoveHookCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsEnabled}" Margin="0,0,6,0"
                                              VerticalAlignment="Center" ToolTip="이 훅을 생성에 적용할지"/>
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="훅 이름 — 슬롯 라벨로도 쓰입니다"/>
                                </DockPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="종류:" VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0"/>
                                    <RadioButton Content="랜덤" IsChecked="{Binding IsRandom}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <RadioButton Content="고정" IsChecked="{Binding IsFixed}" VerticalAlignment="Center"
                                                 ToolTip="후보 태그를 전부 항상 붙입니다(참조 풀을 걸면 그 풀의 후보를 모두 펼쳐 넣습니다)."/>
                                    <TextBlock Text="  매줄" VerticalAlignment="Center" FontSize="11"
                                               Visibility="{Binding IsRandom, Converter={StaticResource BoolToVis}}"/>
                                    <TextBox Text="{Binding MinCount}" Width="30" Margin="4,0" FontSize="11"
                                             Visibility="{Binding IsRandom, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="~" VerticalAlignment="Center" FontSize="11"
                                               Visibility="{Binding IsRandom, Converter={StaticResource BoolToVis}}"/>
                                    <TextBox Text="{Binding MaxCount}" Width="30" Margin="4,0" FontSize="11"
                                             Visibility="{Binding IsRandom, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="개" VerticalAlignment="Center" FontSize="11"
                                               Visibility="{Binding IsRandom, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="위치:" VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0"/>
                                    <RadioButton Content="맨 앞" IsChecked="{Binding PlaceFront}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <RadioButton Content="맨 뒤" IsChecked="{Binding PlaceBack}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <RadioButton Content="N번째" IsChecked="{Binding PlaceAtIndex}" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding Index}" Width="34" Margin="4,0" FontSize="11"
                                             IsEnabled="{Binding PlaceAtIndex}"
                                             ToolTip="0이 맨 앞. 레시피의 슬롯 수보다 크면 맨 뒤로 보정됩니다."/>
                                    <TextBlock Text="  순서" VerticalAlignment="Center" FontSize="11"/>
                                    <TextBox Text="{Binding Order}" Width="34" Margin="4,0" FontSize="11"
                                             ToolTip="같은 위치를 노리는 훅끼리의 앞뒤(작을수록 앞)"/>
                                </StackPanel>

                                <DockPanel Margin="0,4,0,0">
                                    <TextBlock DockPanel.Dock="Left" Text="참조 풀:" VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0"/>
                                    <Button DockPanel.Dock="Right" Content="해제" FontSize="11" Padding="6,0" Margin="4,0,0,0"
                                            Command="{Binding ClearPoolCommand}"
                                            ToolTip="풀 참조를 없애고 직접 입력 태그만 씁니다."/>
                                    <ComboBox ItemsSource="{Binding Pools}" SelectedItem="{Binding SelectedPool}"
                                              DisplayMemberPath="Name" FontSize="11"/>
                                </DockPanel>

                                <TextBox Text="{Binding TagsText, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,0" FontSize="11"
                                         ToolTip="직접 입력 태그(쉼표로 여러 개). 참조 풀의 후보와 합쳐져 하나의 후보군이 됩니다."/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
