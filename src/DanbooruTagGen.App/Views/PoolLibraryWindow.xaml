<Window x:Class="DanbooruTagGen.App.Views.PoolLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="풀 라이브러리" Height="500" Width="700">
    <Grid Margin="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0" Margin="0,0,8,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                <Button Content="+풀" Command="{Binding AddPoolCommand}"/>
                <Button Content="삭제" Command="{Binding RemovePoolCommand}" Margin="4,0"/>
                <Button Content="저장" Command="{Binding SaveCommand}"/>
            </StackPanel>
            <!-- 선택한 풀을 레시피 빌더로 바로 넣는다 — 레시피 빌더로 돌아가 콤보에서 이름을
                 찾을 필요 없이 여기서 한 번에 "불러오기"를 끝내는 지름길.
                 [랜덤]: 매 줄 일부만 무작위로 뽑음(레시피 빌더에서 [랜덤] 슬롯을 선택해
                 둔 상태면 새로 만들지 않고 그 슬롯의 풀만 바꿔치기).
                 [고정]: 풀의 태그 전부를 그대로 복사해 매 줄 항상 출력(스냅샷, 이후 풀을
                 고쳐도 반영 안 됨). -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                <Button Content="[랜덤] 슬롯으로 레시피에 추가" Command="{Binding AddAsRandomSlotCommand}"
                        ToolTip="선택한 풀을 레시피 빌더의 [랜덤] 슬롯에 연결합니다(매 줄 일부만 무작위로 뽑음)."/>
                <Button Content="[고정] 슬롯으로 레시피에 추가" Margin="0,4,0,0" Command="{Binding AddAsFixedSlotCommand}"
                        ToolTip="선택한 풀의 태그 전부를 레시피 빌더에 [고정] 슬롯으로 복사합니다(매 줄 항상 전부 출력)."/>
            </StackPanel>
            <!-- 축 풀이 95개까지 늘어 이름 나열만으론 못 찾는다. 이름에 안 걸리면 그 풀의
                 후보 태그에서도 찾는다("이 태그 어느 축에 있더라"를 바로 확인). -->
            <TextBox DockPanel.Dock="Top" Margin="0,4,0,0"
                     Text="{Binding PoolSearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="풀 이름 또는 그 풀에 든 태그로 검색 (부분 일치)"/>
            <ListBox ItemsSource="{Binding FilteredPools}" SelectedItem="{Binding SelectedPool}"
                     DisplayMemberPath="Name" Margin="0,4,0,0"/>
        </DockPanel>
        <DockPanel Grid.Column="1">
            <TextBox DockPanel.Dock="Top" Text="{Binding SelectedPool.Name, UpdateSourceTrigger=PropertyChanged}"/>
            <!-- 역참조: 이 풀을 쓰는 레시피. 풀을 고치거나 지울 때 영향 범위가 안 보이던 문제. -->
            <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedPoolUsage}" Margin="0,2,0,0"
                       Foreground="#555" FontSize="11" TextWrapping="Wrap"
                       Visibility="{Binding SelectedPoolUsage, Converter={StaticResource NonEmptyToVis}}"/>
            <Button DockPanel.Dock="Bottom" Content="선택 태그 제거" Command="{Binding RemoveSelectedTagCommand}"/>
            <ListBox ItemsSource="{Binding SelectedPoolCandidates}" SelectedItem="{Binding SelectedCandidate}" Margin="0,4"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Background=Transparent: 행 전체가 호버 적중 영역이 되어 툴팁이 안정적으로 뜸 -->
                        <Border Background="Transparent"
                                ToolTipService.InitialShowDelay="100"
                                ToolTipService.ShowDuration="30000">
                            <Border.ToolTip>
                                <StackPanel MaxWidth="360">
                                    <TextBlock Text="{Binding Name, Converter={StaticResource UnderToSpace}}" FontWeight="Bold" FontSize="13"/>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,3,0,3"
                                               Visibility="{Binding Description, Converter={StaticResource NonEmptyToVis}}"/>
                                    <TextBlock Text="{Binding CategoryLabel, StringFormat='카테고리: {0}'}" Foreground="Gray" FontSize="11"
                                               Visibility="{Binding CategoryLabel, Converter={StaticResource NonEmptyToVis}}"/>
                                    <TextBlock Text="{Binding PostCount, StringFormat='빈도: {0:N0}'}" Foreground="Gray" FontSize="11"/>
                                    <TextBlock Text="{Binding AliasesText}" TextWrapping="Wrap" Foreground="Gray" FontSize="11"
                                               Visibility="{Binding AliasesText, Converter={StaticResource NonEmptyToVis}}"/>
                                </StackPanel>
                            </Border.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name, Converter={StaticResource UnderToSpace}}"/>
                                <TextBlock Text="🔞" Margin="4,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding IsNsfw, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</Window>
