<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DanbooruTagGen.Core\DanbooruTagGen.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 동적 PGO 끔: 켜 두면 실행 후 첫 생성이 계측용 코드로 돌아 3~4배 느리다(상납 200줄 첫 회 1.28초 → 0.56초,
         이후 회차 0.33초 → 0.37초, 2026-11-20 실측). 생성은 대개 앱을 켜고 몇 번 돌리는 식이라 첫 회가 더 중요하다. -->
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\data\*.csv" Link="data\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 프로그램 제공 프리셋(축 풀·컨셉 팩). 사용자 커스텀은 %APPDATA%에만 저장되어
         깃/배포에 섞이지 않고, 이 번들만 저장소로 관리된다. -->
    <Content Include="..\..\data\presets\*.json" Link="data\presets\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\data\presets\recipes\**\*.json" Link="data\presets\recipes\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 실제 토크나이저(IL = CLIP, Anima = Qwen3) — 출력 줄 길이를 ComfyUI와 같은 수로 센다(Core.Tokenization). -->
    <Content Include="..\..\data\tokenizers\**\*" Link="data\tokenizers\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
