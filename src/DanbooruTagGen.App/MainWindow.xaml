<Window x:Class="DanbooruTagGen.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DanbooruTagGen.App.Views"
        Title="DanbooruTagGen" Height="720" Width="1200">
    <!-- 단축키: 버튼 툴팁에도 적어 둔다. Ctrl+F(지금 탭의 검색칸으로)는 코드비하인드(포커스 이동이라 뷰 일). -->
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding Generation.PreviewCommand}"/>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding Generation.GenerateCommand}"/>
        <KeyBinding Key="C" Modifiers="Control+Shift" Command="{Binding Generation.CopyPreviewCommand}"/>
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding OpenRecipeLibraryCommand}"/>
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding OpenPoolLibraryCommand}"/>
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 툴바: 글자 있는 버튼만. 가끔 쓰는 것(로그·백업·지운 제공 팩·생성 기록·개발 모드)은 [도구 ▾] 하나로 모은다. -->
        <ToolBarTray Grid.Row="0">
            <ToolBar>
                <Button Content="레시피 라이브러리" Command="{Binding OpenRecipeLibraryCommand}" Margin="4,2"
                        ToolTip="(Ctrl+L) 레시피 라이브러리 · 그 밖의 단축키: F5 미리보기 · Ctrl+Enter 생성 · Ctrl+Shift+C 결과 전체 복사 · Ctrl+F 검색칸 · Ctrl+Z 빌더 되돌리기"/>
                <Button Content="풀 라이브러리" Command="{Binding OpenPoolLibraryCommand}" Margin="4,2" ToolTip="(Ctrl+P) 축 풀 라이브러리"/>
                <Button Content="생성 훅" Command="{Binding OpenHookLibraryCommand}" Margin="4,2"
                        ToolTip="생성할 때만 레시피에 끼워 넣는 사용자 정의 슬롯을 설정합니다(레시피 자체는 안 바뀝니다)."/>
                <Button Content="컨셉 빌더" Command="{Binding OpenConceptWizardCommand}" Margin="4,2"
                        ToolTip="테마 키워드로 관련 태그를 모아 컨셉 레시피를 자동 조립합니다."/>
                <Separator/>
                <Button Content="⟳ 프리셋 갱신" Command="{Binding SyncBundledPresetsCommand}" Margin="4,2"
                        ToolTip="제공 축 풀·컨셉 팩을 최신 내용으로 갱신합니다. 바뀔 레시피를 먼저 보여 주고 확인받습니다."/>
                <Button Content="⚡ 퀵 갱신" Command="{Binding QuickSyncBundledPresetsCommand}" Margin="4,2"
                        ToolTip="확인 없이 바로 갱신합니다(결과는 상태 표시줄에). 동작은 위 버튼과 같습니다."/>
                <Separator/>
                <Menu Background="Transparent" VerticalAlignment="Center">
                    <MenuItem Header="도구 ▾" Padding="6,2">
                        <MenuItem Header="로그…" Command="{Binding OpenLogCommand}"
                                  ToolTip="프로그램 문제·컨셉 제작 문제만 잘라 남긴 로그(최근 7일)."/>
                        <MenuItem Header="백업·복원…" Command="{Binding OpenBackupsCommand}"/>
                        <MenuItem Header="지운 제공 팩…" Command="{Binding OpenDeletedPresetsCommand}"/>
                        <MenuItem Header="생성 기록…" Command="{Binding Generation.ShowGenerationHistoryCommand}"/>
                        <Separator/>
                        <MenuItem Header="개발 모드 (다음 실행부터)" IsCheckable="True" IsChecked="{Binding DevModeSetting}"
                                  Visibility="{Binding DevModeAvailable, Converter={StaticResource BoolToVis}}"
                                  ToolTip="켜면 프리셋·규칙을 exe 옆 사본 대신 저장소의 data/에서 직접 읽고 감시합니다. 저장소에 넣은 작성 중인 레시피가 곧바로 시딩되니 주의하세요."/>
                        <MenuItem Header="{Binding WatchStateText}" IsEnabled="False"/>
                        <MenuItem Header="{Binding LastSyncText}" IsEnabled="False"
                                  Visibility="{Binding LastSyncText, Converter={StaticResource NonEmptyToVis}}"/>
                    </MenuItem>
                </Menu>
            </ToolBar>
        </ToolBarTray>

        <!-- 본문: 탭(왼쪽·가운데) + 두 탭 공통 생성 카드(오른쪽). 생성 대상은 지금 탭이 정한다. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition x:Name="RightColumn" Width="400" MinWidth="320"/>
            </Grid.ColumnDefinitions>
            <TabControl Grid.Column="0" Margin="6,6,0,6" SelectedIndex="{Binding SelectedTabIndex}">
                <TabItem Header="  일괄 생성  ">
                    <views:BatchRecipeListView DataContext="{Binding Generation}"/>
                </TabItem>
                <TabItem Header="  레시피 편집  ">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="LeftColumn" Width="300" MinWidth="180"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*" MinWidth="240"/>
                        </Grid.ColumnDefinitions>
                        <ContentControl Grid.Column="0" Content="{Binding TagSearch}"/>
                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"/>
                        <ContentControl Grid.Column="2" Content="{Binding RecipeBuilder}"/>
                    </Grid>
                </TabItem>
            </TabControl>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"/>
            <ContentControl Grid.Column="2" Content="{Binding Generation}"/>
        </Grid>

        <!-- 상태 표시줄: 상태 문장 한 줄 + 번들 읽기 실패(빨강, 고칠 때까지)만. -->
        <StatusBar Grid.Row="2">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate><DockPanel LastChildFill="True"/></ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Right" Visibility="{Binding PresetLoadError, Converter={StaticResource NonEmptyToVis}}">
                <TextBlock Text="{Binding PresetLoadError}" Foreground="#B71C1C" FontSize="11" MaxWidth="460"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding PresetLoadError}"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
